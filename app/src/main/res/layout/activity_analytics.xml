<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analytics Dashboard"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline4"
        android:textColor="@color/brand_purple"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Analytics Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAnalytics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Average Score -->
            <TextView
                android:id="@+id/tvAverageScoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Average Score:"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvAverageScoreValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="87%"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
                android:textColor="@color/brand_purple"
                android:layout_marginBottom="16dp"/>

            <!-- Overall Accuracy -->
            <TextView
                android:id="@+id/tvOverallAccuracyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overall Accuracy:"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvOverallAccuracyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="92%"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
                android:textColor="@color/brand_purple"
                android:layout_marginBottom="16dp"/>

            <!-- Total Users -->
            <TextView
                android:id="@+id/tvTotalUsersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Users:"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvTotalUsersValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
                android:textColor="@color/brand_purple"
                android:layout_marginBottom="16dp"/>

            <!-- Top Ranked Users -->
            <TextView
                android:id="@+id/tvRankedUsersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top Ranked Users:"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvRankedUsersValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe, Jane Smith, Alex Roe, Sam Johnson"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp"/>

            <!-- Question Analysis -->
            <TextView
                android:id="@+id/tvQuestionAnalysisLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Question Analysis:"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvQuestionAnalysisValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q1: 95% correct (100 attempts)&#10;Q2: 88% correct (100 attempts)&#10;Q3: 92% correct (100 attempts)&#10;Q4: 85% correct (100 attempts)"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:textColor="@android:color/black"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Optional Lottie Animation at Bottom -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnalytics"
        android:layout_width="350dp"
        android:layout_height="350dp"
        app:lottie_rawRes="@raw/analytics_animation"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:layout_constraintTop_toBottomOf="@id/cardAnalytics"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
